# ============================================================
# Shakib Portfolio — Environment Variables Template
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================

# ─── Site URL ────────────────────────────────────────────────
# Used for metadata, OG images, and Better Auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Better Auth ─────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your_super_secret_key_minimum_32_chars_here
BETTER_AUTH_URL=http://localhost:3000

# ─── Owner Access Control ────────────────────────────────────
# The ONLY Google account allowed to log into /admin
OWNER_EMAIL=your-email@gmail.com

# ─── Google OAuth ────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── MongoDB Atlas ───────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_DB=portfolio

# ─── Cloud Storage: AWS S3 or Cloudflare R2 (Optional) ───────
# Required only for file uploads (resume PDF, project images)
# Leave empty to use local public/ directory as fallback
S3_BUCKET=your-bucket-name
S3_REGION=auto
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# For Cloudflare R2, set custom endpoint:
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
# Public CDN base for serving uploaded files:
NEXT_PUBLIC_CDN_URL=https://your-cdn-or-r2-public-domain.com

# ─── Contact Form Email Notifications (Optional) ─────────────
# Uses Resend (https://resend.com) to send contact form alerts
RESEND_API_KEY=re_your_resend_api_key
CONTACT_EMAIL=mdsihabsharar22@gmail.com
